// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    DMux4Way(in= in, sel= sel[0..1], a= aDMuxSel01, b= bDMuxSel01, c= cDMuxSel01, d= dDMuxSel01);
    DMux(in= in, sel= sel[2], a= aDMuxSel2, b= bDMuxSel2);
    And(a= aDMuxSel01, b= aDMuxSel2, out= a);
    And(a= bDMuxSel01, b= aDMuxSel2, out= b);
    And(a= cDMuxSel01, b= aDMuxSel2, out= c);
    And(a= dDMuxSel01, b= aDMuxSel2, out= d);
    And(a= aDMuxSel01, b= bDMuxSel2, out= e);
    And(a= bDMuxSel01, b= bDMuxSel2, out= f);
    And(a= cDMuxSel01, b= bDMuxSel2, out= g);
    And(a= dDMuxSel01, b= bDMuxSel2, out= h);
}