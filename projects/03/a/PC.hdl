// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Or(a= reset, b= inc, out= resetOrInc);
    Or(a= reset, b= load, out= resetOrLoad);
    Or(a= resetOrInc, b= load, out= shouldLoad);

    Inc16(in= prevOut, out= incIn);

    Mux16(a= false, b= incIn, sel= inc, out= tempIn1);
    Mux16(a= tempIn1, b= in, sel= load, out= tempIn2);
    Mux16(a= tempIn2, b= false, sel= reset, out= finalIn);
    
    Register(in= finalIn, load= shouldLoad, out= out, out= prevOut);
}